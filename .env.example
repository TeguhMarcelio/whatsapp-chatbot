GEMINI_API_KEY=your_gemini_api_key_here
# Wajib diisi untuk mengaktifkan command !update dan hak akses owner (pisahkan dengan koma, format angka saja)
OWNER_NUMBER=6281234567890
# Opsional: batasi bot hanya untuk chat/grup tertentu (nomor HP atau group JID, pisahkan dengan koma)
# ALLOWED_CHATS=6281234567890,120363000000000000@g.us
# Opsional: daftar nomor/JID yang diblokir (pisahkan dengan koma)
# BLOCKED_JIDS=
# Opsional: cooldown antar request AI per pengirim (ms, default 4000)
# USER_COOLDOWN_MS=4000
# Opsional: batas request AI yang berjalan bersamaan (default 4)
# MAX_CONCURRENT_AI_REQUESTS=4
